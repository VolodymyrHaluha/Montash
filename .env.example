# Android reads from LOCAL on the named Wi-Fi when healthy, otherwise GLOBAL.
MONTASH_GLOBAL_API_URL=https://frop-attendance.date
MONTASH_LOCAL_API_URL=http://YOUR_LOCAL_LAN_IP:5101
MONTASH_LOCAL_WIFI_SSID=FROP
MONTASH_SERVER_SOURCE_DIR=D:\path\to\FROP-SERVER-TEST-V\server_montash
MONTASH_CLIENT_API_TOKEN=SAME_CLIENT_VALUE_AS_SERVER
